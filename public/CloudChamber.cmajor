    event h5EnableIn (float32 v) { headEnabled.at (4) = v >= 0.5f; }
    event h5LevelIn (float32 v) { headLevel.at (4) = std::levels::dBtoGain (v); refreshHeadGains (4); }
    event h5PanIn (float32 v) { headPan.at (4) = v; refreshHeadGains (4); }
    event h5PanSpreadIn (float32 v) { headPanSpread.at (4) = v; refreshHeadGains (4); }
    event h5PositionIn (float32 v) { headPosition.at (4) = v; anchorHead (4); }
    event h5SprayIn (float32 v) { headSpray.at (4) = v; }
    event h5MotionIn (float32 v) { headMotion.at (4) = v; }
    event h5LoopStartIn (float32 v) { headLoopStart.at (4) = v; }
    event h5LoopLengthIn (float32 v) { headLoopLength.at (4) = v; }
    event h5SizeIn (float32 v) { headSize.at (4) = v; refreshHeadLengths (4); }
    event h5SizeJitterIn (float32 v) { headSizeJitter.at (4) = v; refreshHeadLengths (4); }
    event h5DensityIn (float32 v) { headDensity.at (4) = v; }
    event h5RateJitterIn (float32 v) { headRateJitter.at (4) = v; }
    event h5ShapeIn (float32 v) { headShape.at (4) = v; }
    event h5SkewIn (float32 v) { headSkew.at (4) = v; }
    event h5PitchIn (float32 v) { headPitch.at (4) = v; refreshHeadRates (4); }
    event h5FineIn (float32 v) { headFine.at (4) = v; refreshHeadRates (4); }
    event h5PitchJitterIn (float32 v) { headPitchJitter.at (4) = v; refreshHeadRates (4); }
    event h5ReverseIn (float32 v) { headReverse.at (4) = v; }
