/**
    Cloud Chamber - a granular synthesiser.

    A cloud of short grains read out of one mono buffer. Grains are the only thing that makes
    sound: there is no oscillator behind them, so every parameter here is either about where a
    grain is taken from, how long it lasts, or how it is shaped on the way out.

    Eight independent playheads read that one buffer. A head owns its own loop region, its own
    position and motion through it, and its own grain character - size, density, pitch, shape,
    spray, pan and level - so one head can crawl through a long tail in half-second grains while
    another stutters through the attack an octave up. They are layers rather than voices: every
    note plays every enabled head, and the eight are summed.

    The buffer is filled from the editor rather than from the manifest, because the sample is
    dragged in at runtime. It arrives as a run of chunk events between a sampleBeginIn and a
    sampleEndIn that arms it, so a half-transferred sample is never read. The buffer is mono -
    stereo width comes from panning grains apart, which is both cheaper and, for a drone, wider
    than the source ever was.

    maxSampleFrames is the one hard limit. The editor resamples whatever is dropped so that it
    fits, which means a short sample keeps its own rate and a very long one is brought down until
    it does - the buffer carries its own rate in bufferRate, and grain playback is a ratio, so
    nothing downstream needs to know which happened.

    Two ways to play:

      - MIDI. A note takes a voice, transposes every enabled head by its distance from the root
        note and opens that voice's amplitude envelope.
      - Free run. One extra voice, outside the MIDI pool, held permanently open at the root note.
        This is the drone: the heads keep moving, grains keep being thrown, and no note is needed
        for any of it.

    Each grain samples every parameter once, when it is spawned, and then carries those values to
    its end. That is what makes the jitter controls behave: a grain does not change its mind
    halfway through, so raising Spray widens the cloud rather than smearing the grains already in
    it.
*/
processor CloudChamber [[ main ]]
{
    //==============================================================================
    input event std::midi::Message midiIn [[ name: "MIDI In" ]];

    output stream float32<2> out [[ name: "Audio Out" ]];

    /// At most one grain every grainEmitHz, so the cloud can be drawn without the event queue
    /// having to carry every grain a dense setting produces.
    output event GrainInfo grainOut;

    /// Where every head has reached and how loud the cloud is, on a display clock.
    output event EngineState stateOut;

    /**
        How far the transfer has actually landed, reported as each chunk is taken off the queue.

        The editor paces itself against this rather than against a timer. Sending faster than the
        engine drains leaves the host's message thread retrying against a queue it cannot empty,
        and in a plugin that thread is the one drawing the window - which is why a load used to
        freeze the whole GUI until it finished.
    */
    output event int32 sampleProgressOut;

    //==============================================================================
    // Per-head parameters. Declared one at a time because top-level arrays of inputs are not
    // implemented in the language yet; everything downstream of the handlers is array-indexed.

    // Head 1
    input event float32 h1EnableIn           [[ name: "H1 Enable", min: 0, max: 1, init: 1, text: "Off|On", boolean ]];
    input event float32 h1LevelIn            [[ name: "H1 Level", min: -60, max: 6, init: -6, unit: "dB", step: 0.1 ]];
    input event float32 h1PanIn              [[ name: "H1 Pan", min: -1, max: 1, init: 0, step: 0.001 ]];
    input event float32 h1PanSpreadIn        [[ name: "H1 Pan Spread", min: 0, max: 1, init: 0.4, step: 0.001 ]];
    input event float32 h1PositionIn         [[ name: "H1 Position", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h1SprayIn            [[ name: "H1 Spray", min: 0, max: 1, init: 0.02, step: 0.001 ]];
    input event float32 h1MotionIn           [[ name: "H1 Motion", min: -4, max: 4, init: 0.25, unit: "x", step: 0.001 ]];
    input event float32 h1LoopStartIn        [[ name: "H1 Loop Start", min: 0, max: 1, init: 0, step: 0.0001 ]];
    input event float32 h1LoopLengthIn       [[ name: "H1 Loop Length", min: 0, max: 1, init: 1, step: 0.0001 ]];
    input event float32 h1SizeIn             [[ name: "H1 Size", min: 1, max: 10000, init: 120, unit: "ms", step: 0.1 ]];
    input event float32 h1SizeJitterIn       [[ name: "H1 Size Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h1DensityIn          [[ name: "H1 Density", min: 0.1, max: 1600, init: 24, unit: "Hz", step: 0.1 ]];
    input event float32 h1RateJitterIn       [[ name: "H1 Rate Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h1ShapeIn            [[ name: "H1 Shape", min: 0, max: 1, init: 1, step: 0.001 ]];
    input event float32 h1SkewIn             [[ name: "H1 Skew", min: 0, max: 1, init: 0.5, step: 0.001 ]];
    input event float32 h1PitchIn            [[ name: "H1 Pitch", min: -24, max: 24, init: 0, unit: "st", step: 1 ]];
    input event float32 h1FineIn             [[ name: "H1 Fine", min: -100, max: 100, init: 0, unit: "ct", step: 0.1 ]];
    input event float32 h1PitchJitterIn      [[ name: "H1 Pitch Jitter", min: 0, max: 1200, init: 0, unit: "ct", step: 1 ]];
    input event float32 h1ReverseIn          [[ name: "H1 Reverse", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h1LevelJitterIn      [[ name: "H1 Level Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];

    // Head 2
    input event float32 h2EnableIn           [[ name: "H2 Enable", min: 0, max: 1, init: 0, text: "Off|On", boolean ]];
    input event float32 h2LevelIn            [[ name: "H2 Level", min: -60, max: 6, init: -6, unit: "dB", step: 0.1 ]];
    input event float32 h2PanIn              [[ name: "H2 Pan", min: -1, max: 1, init: 0, step: 0.001 ]];
    input event float32 h2PanSpreadIn        [[ name: "H2 Pan Spread", min: 0, max: 1, init: 0.4, step: 0.001 ]];
    input event float32 h2PositionIn         [[ name: "H2 Position", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h2SprayIn            [[ name: "H2 Spray", min: 0, max: 1, init: 0.02, step: 0.001 ]];
    input event float32 h2MotionIn           [[ name: "H2 Motion", min: -4, max: 4, init: 0.25, unit: "x", step: 0.001 ]];
    input event float32 h2LoopStartIn        [[ name: "H2 Loop Start", min: 0, max: 1, init: 0, step: 0.0001 ]];
    input event float32 h2LoopLengthIn       [[ name: "H2 Loop Length", min: 0, max: 1, init: 1, step: 0.0001 ]];
    input event float32 h2SizeIn             [[ name: "H2 Size", min: 1, max: 10000, init: 120, unit: "ms", step: 0.1 ]];
    input event float32 h2SizeJitterIn       [[ name: "H2 Size Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h2DensityIn          [[ name: "H2 Density", min: 0.1, max: 1600, init: 24, unit: "Hz", step: 0.1 ]];
    input event float32 h2RateJitterIn       [[ name: "H2 Rate Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h2ShapeIn            [[ name: "H2 Shape", min: 0, max: 1, init: 1, step: 0.001 ]];
    input event float32 h2SkewIn             [[ name: "H2 Skew", min: 0, max: 1, init: 0.5, step: 0.001 ]];
    input event float32 h2PitchIn            [[ name: "H2 Pitch", min: -24, max: 24, init: 0, unit: "st", step: 1 ]];
    input event float32 h2FineIn             [[ name: "H2 Fine", min: -100, max: 100, init: 0, unit: "ct", step: 0.1 ]];
    input event float32 h2PitchJitterIn      [[ name: "H2 Pitch Jitter", min: 0, max: 1200, init: 0, unit: "ct", step: 1 ]];
    input event float32 h2ReverseIn          [[ name: "H2 Reverse", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h2LevelJitterIn      [[ name: "H2 Level Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];

    // Head 3
    input event float32 h3EnableIn           [[ name: "H3 Enable", min: 0, max: 1, init: 0, text: "Off|On", boolean ]];
    input event float32 h3LevelIn            [[ name: "H3 Level", min: -60, max: 6, init: -6, unit: "dB", step: 0.1 ]];
    input event float32 h3PanIn              [[ name: "H3 Pan", min: -1, max: 1, init: 0, step: 0.001 ]];
    input event float32 h3PanSpreadIn        [[ name: "H3 Pan Spread", min: 0, max: 1, init: 0.4, step: 0.001 ]];
    input event float32 h3PositionIn         [[ name: "H3 Position", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h3SprayIn            [[ name: "H3 Spray", min: 0, max: 1, init: 0.02, step: 0.001 ]];
    input event float32 h3MotionIn           [[ name: "H3 Motion", min: -4, max: 4, init: 0.25, unit: "x", step: 0.001 ]];
    input event float32 h3LoopStartIn        [[ name: "H3 Loop Start", min: 0, max: 1, init: 0, step: 0.0001 ]];
    input event float32 h3LoopLengthIn       [[ name: "H3 Loop Length", min: 0, max: 1, init: 1, step: 0.0001 ]];
    input event float32 h3SizeIn             [[ name: "H3 Size", min: 1, max: 10000, init: 120, unit: "ms", step: 0.1 ]];
    input event float32 h3SizeJitterIn       [[ name: "H3 Size Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h3DensityIn          [[ name: "H3 Density", min: 0.1, max: 1600, init: 24, unit: "Hz", step: 0.1 ]];
    input event float32 h3RateJitterIn       [[ name: "H3 Rate Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h3ShapeIn            [[ name: "H3 Shape", min: 0, max: 1, init: 1, step: 0.001 ]];
    input event float32 h3SkewIn             [[ name: "H3 Skew", min: 0, max: 1, init: 0.5, step: 0.001 ]];
    input event float32 h3PitchIn            [[ name: "H3 Pitch", min: -24, max: 24, init: 0, unit: "st", step: 1 ]];
    input event float32 h3FineIn             [[ name: "H3 Fine", min: -100, max: 100, init: 0, unit: "ct", step: 0.1 ]];
    input event float32 h3PitchJitterIn      [[ name: "H3 Pitch Jitter", min: 0, max: 1200, init: 0, unit: "ct", step: 1 ]];
    input event float32 h3ReverseIn          [[ name: "H3 Reverse", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h3LevelJitterIn      [[ name: "H3 Level Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];

    // Head 4
    input event float32 h4EnableIn           [[ name: "H4 Enable", min: 0, max: 1, init: 0, text: "Off|On", boolean ]];
    input event float32 h4LevelIn            [[ name: "H4 Level", min: -60, max: 6, init: -6, unit: "dB", step: 0.1 ]];
    input event float32 h4PanIn              [[ name: "H4 Pan", min: -1, max: 1, init: 0, step: 0.001 ]];
    input event float32 h4PanSpreadIn        [[ name: "H4 Pan Spread", min: 0, max: 1, init: 0.4, step: 0.001 ]];
    input event float32 h4PositionIn         [[ name: "H4 Position", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h4SprayIn            [[ name: "H4 Spray", min: 0, max: 1, init: 0.02, step: 0.001 ]];
    input event float32 h4MotionIn           [[ name: "H4 Motion", min: -4, max: 4, init: 0.25, unit: "x", step: 0.001 ]];
    input event float32 h4LoopStartIn        [[ name: "H4 Loop Start", min: 0, max: 1, init: 0, step: 0.0001 ]];
    input event float32 h4LoopLengthIn       [[ name: "H4 Loop Length", min: 0, max: 1, init: 1, step: 0.0001 ]];
    input event float32 h4SizeIn             [[ name: "H4 Size", min: 1, max: 10000, init: 120, unit: "ms", step: 0.1 ]];
    input event float32 h4SizeJitterIn       [[ name: "H4 Size Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h4DensityIn          [[ name: "H4 Density", min: 0.1, max: 1600, init: 24, unit: "Hz", step: 0.1 ]];
    input event float32 h4RateJitterIn       [[ name: "H4 Rate Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h4ShapeIn            [[ name: "H4 Shape", min: 0, max: 1, init: 1, step: 0.001 ]];
    input event float32 h4SkewIn             [[ name: "H4 Skew", min: 0, max: 1, init: 0.5, step: 0.001 ]];
    input event float32 h4PitchIn            [[ name: "H4 Pitch", min: -24, max: 24, init: 0, unit: "st", step: 1 ]];
    input event float32 h4FineIn             [[ name: "H4 Fine", min: -100, max: 100, init: 0, unit: "ct", step: 0.1 ]];
    input event float32 h4PitchJitterIn      [[ name: "H4 Pitch Jitter", min: 0, max: 1200, init: 0, unit: "ct", step: 1 ]];
    input event float32 h4ReverseIn          [[ name: "H4 Reverse", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h4LevelJitterIn      [[ name: "H4 Level Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];

    // Head 5
    input event float32 h5EnableIn           [[ name: "H5 Enable", min: 0, max: 1, init: 0, text: "Off|On", boolean ]];
    input event float32 h5LevelIn            [[ name: "H5 Level", min: -60, max: 6, init: -6, unit: "dB", step: 0.1 ]];
    input event float32 h5PanIn              [[ name: "H5 Pan", min: -1, max: 1, init: 0, step: 0.001 ]];
    input event float32 h5PanSpreadIn        [[ name: "H5 Pan Spread", min: 0, max: 1, init: 0.4, step: 0.001 ]];
    input event float32 h5PositionIn         [[ name: "H5 Position", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h5SprayIn            [[ name: "H5 Spray", min: 0, max: 1, init: 0.02, step: 0.001 ]];
    input event float32 h5MotionIn           [[ name: "H5 Motion", min: -4, max: 4, init: 0.25, unit: "x", step: 0.001 ]];
    input event float32 h5LoopStartIn        [[ name: "H5 Loop Start", min: 0, max: 1, init: 0, step: 0.0001 ]];
    input event float32 h5LoopLengthIn       [[ name: "H5 Loop Length", min: 0, max: 1, init: 1, step: 0.0001 ]];
    input event float32 h5SizeIn             [[ name: "H5 Size", min: 1, max: 10000, init: 120, unit: "ms", step: 0.1 ]];
    input event float32 h5SizeJitterIn       [[ name: "H5 Size Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h5DensityIn          [[ name: "H5 Density", min: 0.1, max: 1600, init: 24, unit: "Hz", step: 0.1 ]];
    input event float32 h5RateJitterIn       [[ name: "H5 Rate Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h5ShapeIn            [[ name: "H5 Shape", min: 0, max: 1, init: 1, step: 0.001 ]];
    input event float32 h5SkewIn             [[ name: "H5 Skew", min: 0, max: 1, init: 0.5, step: 0.001 ]];
    input event float32 h5PitchIn            [[ name: "H5 Pitch", min: -24, max: 24, init: 0, unit: "st", step: 1 ]];
    input event float32 h5FineIn             [[ name: "H5 Fine", min: -100, max: 100, init: 0, unit: "ct", step: 0.1 ]];
    input event float32 h5PitchJitterIn      [[ name: "H5 Pitch Jitter", min: 0, max: 1200, init: 0, unit: "ct", step: 1 ]];
    input event float32 h5ReverseIn          [[ name: "H5 Reverse", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h5LevelJitterIn      [[ name: "H5 Level Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];

    // Head 6
    input event float32 h6EnableIn           [[ name: "H6 Enable", min: 0, max: 1, init: 0, text: "Off|On", boolean ]];
    input event float32 h6LevelIn            [[ name: "H6 Level", min: -60, max: 6, init: -6, unit: "dB", step: 0.1 ]];
    input event float32 h6PanIn              [[ name: "H6 Pan", min: -1, max: 1, init: 0, step: 0.001 ]];
    input event float32 h6PanSpreadIn        [[ name: "H6 Pan Spread", min: 0, max: 1, init: 0.4, step: 0.001 ]];
    input event float32 h6PositionIn         [[ name: "H6 Position", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h6SprayIn            [[ name: "H6 Spray", min: 0, max: 1, init: 0.02, step: 0.001 ]];
    input event float32 h6MotionIn           [[ name: "H6 Motion", min: -4, max: 4, init: 0.25, unit: "x", step: 0.001 ]];
    input event float32 h6LoopStartIn        [[ name: "H6 Loop Start", min: 0, max: 1, init: 0, step: 0.0001 ]];
    input event float32 h6LoopLengthIn       [[ name: "H6 Loop Length", min: 0, max: 1, init: 1, step: 0.0001 ]];
    input event float32 h6SizeIn             [[ name: "H6 Size", min: 1, max: 10000, init: 120, unit: "ms", step: 0.1 ]];
    input event float32 h6SizeJitterIn       [[ name: "H6 Size Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h6DensityIn          [[ name: "H6 Density", min: 0.1, max: 1600, init: 24, unit: "Hz", step: 0.1 ]];
    input event float32 h6RateJitterIn       [[ name: "H6 Rate Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h6ShapeIn            [[ name: "H6 Shape", min: 0, max: 1, init: 1, step: 0.001 ]];
    input event float32 h6SkewIn             [[ name: "H6 Skew", min: 0, max: 1, init: 0.5, step: 0.001 ]];
    input event float32 h6PitchIn            [[ name: "H6 Pitch", min: -24, max: 24, init: 0, unit: "st", step: 1 ]];
    input event float32 h6FineIn             [[ name: "H6 Fine", min: -100, max: 100, init: 0, unit: "ct", step: 0.1 ]];
    input event float32 h6PitchJitterIn      [[ name: "H6 Pitch Jitter", min: 0, max: 1200, init: 0, unit: "ct", step: 1 ]];
    input event float32 h6ReverseIn          [[ name: "H6 Reverse", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h6LevelJitterIn      [[ name: "H6 Level Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];

    // Head 7
    input event float32 h7EnableIn           [[ name: "H7 Enable", min: 0, max: 1, init: 0, text: "Off|On", boolean ]];
    input event float32 h7LevelIn            [[ name: "H7 Level", min: -60, max: 6, init: -6, unit: "dB", step: 0.1 ]];
    input event float32 h7PanIn              [[ name: "H7 Pan", min: -1, max: 1, init: 0, step: 0.001 ]];
    input event float32 h7PanSpreadIn        [[ name: "H7 Pan Spread", min: 0, max: 1, init: 0.4, step: 0.001 ]];
    input event float32 h7PositionIn         [[ name: "H7 Position", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h7SprayIn            [[ name: "H7 Spray", min: 0, max: 1, init: 0.02, step: 0.001 ]];
    input event float32 h7MotionIn           [[ name: "H7 Motion", min: -4, max: 4, init: 0.25, unit: "x", step: 0.001 ]];
    input event float32 h7LoopStartIn        [[ name: "H7 Loop Start", min: 0, max: 1, init: 0, step: 0.0001 ]];
