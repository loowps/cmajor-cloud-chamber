    // Head 8
    input event float32 h8EnableIn           [[ name: "H8 Enable", min: 0, max: 1, init: 0, text: "Off|On", boolean ]];
    input event float32 h8LevelIn            [[ name: "H8 Level", min: -60, max: 6, init: -6, unit: "dB", step: 0.1 ]];
    input event float32 h8PanIn              [[ name: "H8 Pan", min: -1, max: 1, init: 0, step: 0.001 ]];
    input event float32 h8PanSpreadIn        [[ name: "H8 Pan Spread", min: 0, max: 1, init: 0.4, step: 0.001 ]];
    input event float32 h8PositionIn         [[ name: "H8 Position", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h8SprayIn            [[ name: "H8 Spray", min: 0, max: 1, init: 0.02, step: 0.001 ]];
    input event float32 h8MotionIn           [[ name: "H8 Motion", min: -4, max: 4, init: 0.25, unit: "x", step: 0.001 ]];
