{
  "name": "cloud-chamber",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite",
    "build-dev": "run-p type-check-watch \"build-watch {@}\" --",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-clap": "run-s build generate-clap",
    "generate-clap": "cmaj generate --target=clap --clapIncludePath=../clap/include --output=dist-clap dist/CloudChamber.cmajorpatch",
    "preview": "vite preview",
    "test:unit": "vitest --run",
    "test:unit:watch": "vitest",
    "test:ci": "vitest --run --coverage --reporter=default --reporter=junit --outputFile=test-results/junit.xml",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "build-only": "vite build",
    "build-watch": "vite build --watch",
    "type-check": "vue-tsc --build --force",
    "type-check-watch": "vue-tsc --build --force --watch",
    "lint": "eslint",
    "format": "prettier --write src/ e2e/",
    "format:check": "prettier --check src/ e2e/",
    "verify": "run-s type-check lint test:ci"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.13"
  }
}
