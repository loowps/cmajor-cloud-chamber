    input event float32 h7SizeIn             [[ name: "H7 Size", min: 1, max: 10000, init: 120, unit: "ms", step: 0.1 ]];
    input event float32 h7SizeJitterIn       [[ name: "H7 Size Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h7DensityIn          [[ name: "H7 Density", min: 0.1, max: 1600, init: 24, unit: "Hz", step: 0.1 ]];
    input event float32 h7RateJitterIn       [[ name: "H7 Rate Jitter", min: 0, max: 1, init: 0, step: 0.001 ]];
    input event float32 h7ShapeIn            [[ name: "H7 Shape", min: 0, max: 1, init: 1, step: 0.001 ]];
    input event float32 h7SkewIn             [[ name: "H7 Skew", min: 0, max: 1, init: 0.5, step: 0.001 ]];
    input event float32 h7PitchIn            [[ name: "H7 Pitch", min: -24, max: 24, init: 0, unit: "st", step: 1 ]];
    input event float32 h7FineIn             [[ name: "H7 Fine", min: -100, max: 100, init: 0, unit: "ct", step: 0.1 ]];
    input event float32 h7PitchJitterIn      [[ name: "H7 Pitch Jitter", min: 0, max: 1200, init: 0, unit: "ct", step: 1 ]];
