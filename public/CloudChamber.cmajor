    //==============================================================================
    event attackIn   (float32 v) { paramAttack = v; }
    event decayIn    (float32 v) { paramDecay = v; }
    event sustainIn  (float32 v) { paramSustain = v; }
    event releaseIn  (float32 v) { paramRelease = v; }
    event keyTrackIn (float32 v) { paramKeyTrack = v; refreshAllRates(); }
    event gainIn     (float32 v) { targetGain = std::levels::dBtoGain (v); }

    /**
        The drone is at the root by definition, so its note has to follow the root rather than
        having been copied from it when Free Run was switched on. Left stale, raising Root Note
        transposes the drone *down* by the amount it was raised.
    */
    event rootNoteIn (float32 v)
    {
        paramRootNote = clamp (int32 (v), 0, 127);
        voiceNote.at (droneVoice) = paramRootNote;

        /// Its grains carry the root they were sounded at, so they have to move with it too -
        /// left behind, Key Track reads the gap between the new root and the old one as an
        /// interval and transposes the cloud away from the note the drone is now at.
        for (int32 i = 0; i < maxGrains; ++i)
            if (grains.at (i).active && grains.at (i).voice == droneVoice)
                grains.at (i).note = paramRootNote;

        refreshAllRates();
    }

    event freeRunIn (float32 v)
    {
        paramFreeRun = v >= 0.5f;

        if (paramFreeRun)
        {
            voiceActive.at (droneVoice) = true;
            voiceNote.at (droneVoice) = paramRootNote;
            voiceVelocity.at (droneVoice) = 1.0f;
            voiceEnvStage.at (droneVoice) = envAttack;
            /// Stamped like a note's, so the newest thing sounding is what the editor draws.
            voiceStartedAt.at (droneVoice) = ++voiceClock;
            resetVoiceScheduling (droneVoice);
        }
        else if (voiceEnvStage.at (droneVoice) != envIdle)
        {
            voiceActive.at (droneVoice) = false;
            voiceEnvStage.at (droneVoice) = envRelease;
        }
    }

    //==============================================================================
    event midiIn (std::midi::Message message)
    {
        if (message.isNoteOn())
            startNote (message.getNoteNumber(), message.getFloatVelocity());
        else if (message.isNoteOff())
            stopNote (message.getNoteNumber());
    }

    //==============================================================================
    /**
        Nothing is cleared here. The buffer is only ever read inside [0, sampleFrameCount), the
        editor covers exactly that span with chunks, and sampleReady stays false until the last
        one lands - so whatever the previous sample left behind is overwritten before anything
        can reach it. Zeroing 134MB would be a stall on the audio thread for no gain.
    */
    event sampleBeginIn (SampleInfo info)
    {
        sampleReady = false;
        sampleFrameCount = clamp (info.frameCount, 0, maxSampleFrames);
        bufferRate = info.sampleRate > 1.0f ? float64 (info.sampleRate) : 48000.0;

        killAllGrains();
        resetHeads();
    }

    event sampleChunkIn (SampleChunk chunk)
    {
        let count = clamp (chunk.frameCount, 0, chunkFrames);

        for (int32 i = 0; i < count; ++i)
        {
            let target = chunk.startFrame + i;

            if (target >= 0 && target < sampleFrameCount)
                sampleBuffer.at (target) = chunk.frames.at (i);
        }

        sampleProgressOut <- chunk.startFrame + count;
    }

    event sampleEndIn (int32 frameCount)
    {
        if (frameCount > 0)
            sampleFrameCount = clamp (frameCount, 0, maxSampleFrames);

        sampleReady = sampleFrameCount > 1;
        resetHeads();
    }

    /// Every voice's copy of the head, so Position 0% is the loop start for whatever plays next
    /// as well as for whatever is sounding now.
    void anchorHead (int32 head)
    {
        for (int32 v = 0; v < voiceCount; ++v)
            headScanFrames.at (v * headCount + head) = 0.0;
    }

    /// A voice's heads back at Position. A finished voice is anchored as well as a starting one,
    /// so a silent window draws where the next note will begin rather than where the last one
    /// left off.
    void anchorVoice (int32 voice)
    {
        for (int32 h = 0; h < headCount; ++h)
            headScanFrames.at (voice * headCount + h) = 0.0;
    }

    void resetHeads()
    {
        for (int32 h = 0; h < headCount; ++h)
            anchorHead (h);
    }

    //==============================================================================
    void startNote (int32 note, float32 velocity)
    {
        let v = allocateVoice();

        voiceActive.at (v) = true;
        voiceNote.at (v) = note;
        voiceVelocity.at (v) = velocity;
        voiceEnvStage.at (v) = envAttack;
        voiceStartedAt.at (v) = ++voiceClock;

        resetVoiceScheduling (v);
    }

    void stopNote (int32 note)
    {
        for (int32 i = 0; i < midiVoiceCount; ++i)
        {
            if (voiceActive.at (i) && voiceNote.at (i) == note)
            {
                voiceActive.at (i) = false;
                voiceEnvStage.at (i) = envRelease;
            }
        }
    }

    int32 allocateVoice()
    {
        int32 oldest = 0;
        int64 oldestStart = voiceClock + 1;

        for (int32 i = 0; i < midiVoiceCount; ++i)
        {
            if (voiceEnvStage.at (i) == envIdle)
                return i;

            if (voiceStartedAt.at (i) < oldestStart)
            {
                oldestStart = voiceStartedAt.at (i);
                oldest = i;
            }
        }

        return oldest;
    }

    /**
        Every head starts full, so a note's first grain from each of them lands on the note rather
        than a Density interval later - and every head starts at Position, so the note reads from
        where the knob says rather than from wherever Motion had drifted to in the silence.

        Free Run gates the drone through here too, so it begins exactly as a played note does.
    */
    void resetVoiceScheduling (int32 voice)
    {
        for (int32 h = 0; h < headCount; ++h)
        {
            spawnPhase.at (voice * headCount + h) = 1.0;
            intervalScale.at (voice * headCount + h) = nextIntervalScale (h);
        }

        anchorVoice (voice);
    }

    //==============================================================================
    void buildRampTable()
    {
        for (int32 i = 0; i < rampTableSize; ++i)
            rampTable.at (i) = float32 (0.5 - 0.5 * cos (float64 (i) * (pi / float64 (rampTableSize - 1))));
    }

    /// The ramp read at a fraction of its own length, so an edge of any duration costs the same.
    float32 rampAt (float32 fraction)
    {
        let index = clamp (fraction, 0.0f, 1.0f) * float32 (rampTableSize - 1);
        let lower = int32 (index);
        let upper = min (lower + 1, rampTableSize - 1);
        let mix = index - float32 (lower);

        return rampTable.at (lower) * (1.0f - mix) + rampTable.at (upper) * mix;
    }

    /**
        Shape at 1 is a raised cosine over the whole grain and at 0 is a rectangle, with Skew
        deciding how whatever ramp is left gets split between the two ends. A grain with no ramp
        at all clicks, which is the point of having the control - it is a usable sound, not a
        fault.
    */
    float32 grainEnvelope (float64 phase, float32 attackFraction, float32 decayFraction)
    {
        let p = float32 (phase);

        if (attackFraction > 0.0f && p < attackFraction)
            return rampAt (p / attackFraction);

        if (decayFraction > 0.0f && p > 1.0f - decayFraction)
            return rampAt ((1.0f - p) / decayFraction);

        return 1.0f;
    }

    //==============================================================================
    int32 loopStartFrame (int32 head)
    {
        return clamp (int32 (headLoopStart.at (head) * float32 (sampleFrameCount)),
                      0, max (0, sampleFrameCount - 1));
    }

    int32 loopLengthFrames (int32 head)
    {
        let start = loopStartFrame (head);
        let requested = int32 (headLoopLength.at (head) * float32 (sampleFrameCount));

        return clamp (requested, 1, max (1, sampleFrameCount - start));
    }

    float64 wrapInto (float64 value, float64 span)
    {
        if (span <= 0.0)
            return 0.0;

        var result = value % span;

        if (result < 0.0)
            result += span;

        return result;
    }

    /**
        Where a head has reached inside its own loop region: Position anchors it, Motion drifts it
        from there, and the end of the region wraps back to its start. Grains are taken from here
        and the editor draws it, so the bar on the waveform is the place that head's grains are
        coming from rather than a second reading that happens to sit nearby.
    */
    float64 readHeadOffset (int32 voice, int32 head)
    {
        let regionLength = float64 (loopLengthFrames (head));

        return wrapInto (float64 (headPosition.at (head)) * regionLength
                           + headScanFrames.at (voice * headCount + head),
                         regionLength);
    }

    //==============================================================================
    int32 findFreeGrain()
    {
        for (int32 i = 0; i < maxGrains; ++i)
            if (! grains.at (i).active)
                return i;

        /// The pool is full, so the grain furthest through its own envelope is the one whose loss
        /// is least audible - it is already on the way out. Taken across the whole pool rather
        /// than within a head, so a head that is idle cannot hold slots away from one that is
        /// asking for them.
        int32 furthest = 0;
        float64 furthestPhase = -1.0;

        for (int32 i = 0; i < maxGrains; ++i)
        {
            let phase = grains.at (i).envPhase;

            if (phase > furthestPhase)
            {
                furthestPhase = phase;
                furthest = i;
            }
        }

        return furthest;
    }

    void killAllGrains()
    {
        for (int32 i = 0; i < maxGrains; ++i)
            grains.at (i).active = false;
    }

    /// Scales the interval rather than the rate, so Rate Jitter at full spreads the gaps evenly
    /// either side of the one Density asks for instead of only ever shortening them.
    float64 nextIntervalScale (int32 head)
    {
        return 1.0 + float64 (headRateJitter.at (head) * rng.getBipolar() * 0.75f);
    }

    //==============================================================================
    /**
        Grains sum, so a head gets louder as well as thicker: how many of its own grains are
        sounding at once is Density times Size, and at ten seconds a grain that is a swing of
        thirty decibels across the two knobs. Without this, Density and Size are level controls
        as much as they are what they say they are, and Level cannot be set until they are.

        The divisor is the **square root** of that overlap, not the overlap itself. Grains drawn
        from a drifting head at scattered positions are uncorrelated, so they sum in power rather
        than in amplitude and the total rises as the root of their number - dividing by the
        number outright would make a thick cloud quieter than a sparse one. It is exact for a
        cloud that is fully decorrelated and conservative for one that is not: at Spray and
        Motion both at zero every grain reads the same frames at the same rate, and there some
        buildup is left in.

        It only ever attenuates. Boosting to hold a level up would put the gain of a lone grain
        under the count of grains that are not there, which is a swell into every gap in a sparse
        cloud.

        Clamped at maxGrains because the pool is the real ceiling on the count: past it grains
        are stolen rather than added, so an estimate that kept climbing would go on turning a
        head down after it had stopped getting any thicker.

        **Latched on the grain, unlike everything else Density and Size touch.** The figure is a
        prediction of how many grains a setting will end up sounding at once, so it is only ever
        true of a cloud that setting has had time to build. Applied to grains already in the air
        it is a prediction about a population that does not exist: pull Density back from 1600Hz
        with 1024 ten-second grains still sounding and all 1024 are rescaled at once to the gain
        meant for a cloud of ten, which is a 30dB peak that then decays over the ten seconds the
        old grains take to die.

        Carried instead, each grain keeps the estimate of the cloud it was actually part of. The
        old grains fade out under their own count while the new ones arrive under theirs, each
        population is normalised against itself, and the total holds flat across the move rather
        than peaking and settling.
    */
    float32 headDensityCompensation (int32 head)
    {
        let overlap = headDensity.at (head) * headSize.at (head) * 0.001f;

        return 1.0f / sqrt (clamp (overlap, 1.0f, float32 (maxGrains)));
    }

    float32 grainLevel (int32 grain)
    {
        let head = grains.at (grain).head;

        return grains.at (grain).velocity
                * headLevel.at (head)
                * grains.at (grain).densityCompensation
                * (1.0f - headLevelJitter.at (head) * grains.at (grain).levelJitterDraw);
    }

    /// The head's own placement, widened by its spread. Clamped because the two together can
    /// ask for more than the stereo field has.
    float32 grainPan (int32 grain)
    {
        let head = grains.at (grain).head;

        return clamp (headPan.at (head) + headPanSpread.at (head) * grains.at (grain).panDraw,
                      -1.0f, 1.0f);
    }

    float64 grainIncrement (int32 grain)
    {
        let head = grains.at (grain).head;

        let semitones = headPitch.at (head)
                         + headFine.at (head) * 0.01f
                         + headPitchJitter.at (head) * grains.at (grain).pitchJitterDraw * 0.01f
                         + float32 (grains.at (grain).note - paramRootNote) * paramKeyTrack;

        return grains.at (grain).rateSign
                * float64 (pow (2.0f, semitones * (1.0f / 12.0f)))
                * (bufferRate / processor.frequency);
    }

    void applyGrainGains (int32 grain)
    {
        let level = grainLevel (grain);
        let pan = grainPan (grain);

        grains.at (grain).gainLeft = level * sqrt (0.5f * (1.0f - pan));
        grains.at (grain).gainRight = level * sqrt (0.5f * (1.0f + pan));
    }

    /**
        Size sets the rate the envelope runs at, not where in it a grain has got to.

        envPhase is kept and envDelta rescaled, so a grain half way through is still half way
        through and only the time it has left changes. The other reading - phase recomputed from
        the frames already elapsed - ends a shortened grain wherever its window happened to have
        climbed to, which is a click on every grain at once at the moment the knob moves.
    */
    float64 grainLengthSeconds (int32 grain)
    {
        let head = grains.at (grain).head;
        let sizeScale = 1.0 + float64 (headSizeJitter.at (head)
                                         * grains.at (grain).sizeJitterDraw * 0.9f);

        return max (0.0005, float64 (headSize.at (head)) * 0.001 * sizeScale);
    }

    void applyGrainLength (int32 grain)
    {
        grains.at (grain).envDelta
            = 1.0 / max (1.0, grainLengthSeconds (grain) * processor.frequency);
    }

    /**
        Re-derived on the parameter rather than on every sample.

        A gain is two square roots and a rate is a pow, so following them in the render loop
        would put both on each of up to 1024 grains 48000 times a second, to answer a knob that
        moves a handful of times a block. Walked here the pool costs one pass per event and the
        render loop keeps reading the same fields it always did.
    */
    void refreshHeadLengths (int32 head)
    {
        for (int32 i = 0; i < maxGrains; ++i)
            if (grains.at (i).active && grains.at (i).head == head)
                applyGrainLength (i);
    }

    void refreshHeadGains (int32 head)
    {
        for (int32 i = 0; i < maxGrains; ++i)
            if (grains.at (i).active && grains.at (i).head == head)
                applyGrainGains (i);
    }

    void refreshHeadRates (int32 head)
    {
        for (int32 i = 0; i < maxGrains; ++i)
            if (grains.at (i).active && grains.at (i).head == head)
                grains.at (i).increment = grainIncrement (i);
    }

    /// Key Track and Root Note belong to the instrument rather than to a layer, so they move
    /// every head's grains at once.
    void refreshAllRates()
    {
        for (int32 i = 0; i < maxGrains; ++i)
            if (grains.at (i).active)
                grains.at (i).increment = grainIncrement (i);
    }

    void spawnGrain (int32 voice, int32 head)
    {
        if (! sampleReady)
            return;

        let regionStart = float64 (loopStartFrame (head));
        let regionLength = float64 (loopLengthFrames (head));

        let sprayOffset = float64 (headSpray.at (head) * rng.getBipolar() * 0.5f) * regionLength;
        let offsetInRegion = wrapInto (readHeadOffset (voice, head) + sprayOffset, regionLength);

        let sizeJitterDraw = rng.getBipolar();
        let pitchJitterDraw = rng.getBipolar();
        let rateSign = rng.getUnipolar() < headReverse.at (head) ? -1.0 : 1.0;
        let panDraw = rng.getBipolar();
        let levelJitterDraw = rng.getUnipolar();

        let edge = clamp (headShape.at (head), 0.0f, 1.0f);
        let skew = clamp (headSkew.at (head), 0.0f, 1.0f);

        let slot = findFreeGrain();

        grains.at (slot).active = true;
        grains.at (slot).voice = voice;
        grains.at (slot).head = head;
        grains.at (slot).note = voiceNote.at (voice);
        grains.at (slot).velocity = voiceVelocity.at (voice);
        grains.at (slot).levelJitterDraw = levelJitterDraw;
        grains.at (slot).panDraw = panDraw;
        grains.at (slot).pitchJitterDraw = pitchJitterDraw;
        grains.at (slot).sizeJitterDraw = sizeJitterDraw;
        grains.at (slot).densityCompensation = headDensityCompensation (head);
        grains.at (slot).rateSign = rateSign;
        grains.at (slot).readPos = regionStart + offsetInRegion;
        grains.at (slot).regionStart = regionStart;
        grains.at (slot).regionLength = regionLength;
        grains.at (slot).crossfadeFrames = min (loopCrossfadeSeconds * bufferRate, regionLength * 0.5);
        grains.at (slot).envPhase = 0.0;
        grains.at (slot).attackFraction = edge * skew;
        grains.at (slot).decayFraction = edge * (1.0f - skew);

        applyGrainLength (slot);
        applyGrainGains (slot);
        grains.at (slot).increment = grainIncrement (slot);

        emitGrain (grains.at (slot).readPos, grainLengthSeconds (slot), grainLevel (slot),
                   grainPan (slot), grains.at (slot).increment, voice, head);
    }

    void emitGrain (float64 readPos, float64 lengthSeconds, float32 level, float32 pan,
                    float64 increment, int32 voice, int32 head)
    {
        if (grainEmitCountdown > 0.0)
            return;

        grainEmitCountdown = processor.frequency / float64 (grainEmitHz);

        GrainInfo info;
        info.position = sampleFrameCount > 0 ? float32 (readPos / float64 (sampleFrameCount)) : 0.0f;
        info.lengthSeconds = float32 (lengthSeconds);
        info.level = level;
        info.pan = pan;
        info.rate = float32 (increment);
        info.voice = voice;
        info.head = head;

        grainOut <- info;
    }

    //==============================================================================
    /// The neighbours a four-point read needs, held inside the loaded span. One step either way
    /// is all that is ever asked for, so a comparison is cheaper than a clamp against both ends.
    int32 edgeIndex (int32 index)
    {
        if (index < 0)
            return 0;

        if (index >= sampleFrameCount)
            return sampleFrameCount - 1;

        return index;
    }

    /**
        Catmull-Rom rather than linear.

        A grain is almost never read at unity - Pitch, Fine, Pitch Jitter and the ratio between
        the buffer's rate and the host's all land it between samples - so the interpolator is in
        the signal path continuously rather than occasionally. Linear interpolation is a poor
        reconstruction filter: it rolls the top octave off and leaves images behind that read as
        grit on anything transposed. Four points and a cubic cost a handful of multiply-adds per
        grain and take that grit away.

        It does not, and cannot, fix aliasing from transposing *upward*: past unity the read is
        undersampling the buffer, and no interpolator recovers what the steps between samples
        never carried. That needs a band-limited copy to read from, which is a different and far
        more expensive change.

        Outside the loaded span is silence, not a wrap back to frame zero. A grain reads inside
        its own region, so the only thing that ever asks for a position outside the span is
        readGrain's partner read across a join that sits on the start or the end of the file -
        and answering that with frame zero would splice the two ends of the file together under
        the fade. Silence makes the join a fade in or out of the material instead.
    */
    float32 readBuffer (float64 position)
    {
        if (sampleFrameCount < 4)
            return 0.0f;

        if (position < 0.0 || position >= float64 (sampleFrameCount))
            return 0.0f;

        let index = int32 (position);
        let mix = float32 (position - float64 (index));

        let x0 = sampleBuffer.at (edgeIndex (index - 1));
        let x1 = sampleBuffer.at (index);
        let x2 = sampleBuffer.at (edgeIndex (index + 1));
        let x3 = sampleBuffer.at (edgeIndex (index + 2));

        let a = -0.5f * x0 + 1.5f * x1 - 1.5f * x2 + 0.5f * x3;
        let b = x0 - 2.5f * x1 + 2.0f * x2 - 0.5f * x3;
        let c = -0.5f * x0 + 0.5f * x2;

        return ((a * mix + b) * mix + c) * mix + x1;
    }

    /// Equal power rather than equal gain: the two sides of a join are unrelated material, so a
    /// linear blend of them dips through the middle of the fade instead of holding level.
    float32 mixAcrossJoin (float32 here, float32 partner, float64 hereWeight)
    {
        let w = clamp (float32 (hereWeight), 0.0f, 1.0f);

        return here * sqrt (w) + partner * sqrt (1.0f - w);
    }

    /**
        A grain's read: its own loop region, with the join crossfaded.

        The region's last crossfadeFrames are mixed with the frames running up to its start, and
        its first with the frames running past its end, so both sides of the join are half of
        each other and the seam is continuous whatever the material either side of it does. The
        two branches are the same fade seen from either side, which is what lets a reversed grain
        take it without a case of its own - and what keeps a grain that never crosses the join
        reading the same edges as one that does.

        Either partner can fall outside the loaded span, where readBuffer answers silence and the
        join becomes a fade rather than a blend. That is the case a region ending on the end of
        the file used to click on: the grain now fades over the file's end instead of stepping
        across it.
    */
    float32 readGrain (int32 grain)
    {
        let position = grains.at (grain).readPos;
        let regionLength = grains.at (grain).regionLength;
        let fade = grains.at (grain).crossfadeFrames;
        let here = readBuffer (position);

        if (fade <= 0.0)
            return here;

        let offset = position - grains.at (grain).regionStart;

        if (offset < fade)
            return mixAcrossJoin (here, readBuffer (position + regionLength),
                                  0.5 + 0.5 * (offset / fade));

        if (offset > regionLength - fade)
            return mixAcrossJoin (here, readBuffer (position - regionLength),
                                  0.5 + 0.5 * ((regionLength - offset) / fade));

        return here;
    }

    /// The region is what a grain runs round, not the buffer - so the same region sounds the same
    /// wherever in the file it has been put, and a grain outlives the head that placed it.
    void advanceGrain (int32 grain)
    {
        let offset = grains.at (grain).readPos - grains.at (grain).regionStart
                       + grains.at (grain).increment;

        grains.at (grain).readPos = grains.at (grain).regionStart
                                      + wrapInto (offset, grains.at (grain).regionLength);
    }

    //==============================================================================
    float32 envelopeRate (float32 milliseconds)
    {
        let frames = float64 (max (0.1f, milliseconds)) * 0.001 * processor.frequency;
        return float32 (1.0 / max (1.0, frames));
    }

    void advanceVoiceEnvelope (int32 voice)
    {
        let stage = voiceEnvStage.at (voice);

        if (stage == envAttack)
        {
            voiceEnvLevel.at (voice) += envelopeRate (paramAttack);

            if (voiceEnvLevel.at (voice) >= 1.0f)
            {
                voiceEnvLevel.at (voice) = 1.0f;
                voiceEnvStage.at (voice) = envDecay;
            }
        }
        else if (stage == envDecay)
        {
            voiceEnvLevel.at (voice) -= envelopeRate (paramDecay) * (1.0f - paramSustain);

            if (voiceEnvLevel.at (voice) <= paramSustain)
            {
                voiceEnvLevel.at (voice) = paramSustain;
                voiceEnvStage.at (voice) = envSustain;
            }
        }
        else if (stage == envRelease)
        {
            voiceEnvLevel.at (voice) -= envelopeRate (paramRelease);

            if (voiceEnvLevel.at (voice) <= 0.0f)
            {
                voiceEnvLevel.at (voice) = 0.0f;
                voiceEnvStage.at (voice) = envIdle;
                anchorVoice (voice);
            }
        }
    }

    //==============================================================================
    void scheduleGrains()
    {
        for (int32 v = 0; v < voiceCount; ++v)
        {
            advanceVoiceEnvelope (v);

            if (voiceEnvStage.at (v) == envIdle)
                continue;

            for (int32 h = 0; h < headCount; ++h)
            {
                if (! headEnabled.at (h))
                    continue;

                let slot = v * headCount + h;

                spawnPhase.at (slot) += float64 (headDensity.at (h)) * intervalScale.at (slot)
                                          / processor.frequency;

                if (spawnPhase.at (slot) < 1.0)
                    continue;

                // Carried rather than reset, so the fraction the phase overshot by is not thrown
                // away and a fast setting keeps its average rate.
                spawnPhase.at (slot) -= 1.0;
                intervalScale.at (slot) = nextIntervalScale (h);

                spawnGrain (v, h);
            }
        }
    }

    //==============================================================================
    /**
        Motion drifts a head only while the voice holding it is sounding. Silent, every head stays
        anchored at Position, so a note reads from where the knob says rather than from wherever
        the silence had carried it.

        Within a sounding voice every head drifts, enabled or not, so switching one on picks it up
        where it would have been rather than jumping it back to wherever it was last heard.

        The head loop is the outer one: the region length and the per-frame drift belong to the
        head, and computing them once for all nine voices keeps this at an add and a wrap per
        voice.
    */
    void advanceScan()
    {
        if (! sampleReady)
            return;

        for (int32 h = 0; h < headCount; ++h)
        {
            let regionLength = float64 (loopLengthFrames (h));
            let drift = float64 (headMotion.at (h)) * (bufferRate / processor.frequency);

            for (int32 v = 0; v < voiceCount; ++v)
            {
                if (voiceEnvStage.at (v) == envIdle)
                    continue;

                let slot = v * headCount + h;
                headScanFrames.at (slot) = wrapInto (headScanFrames.at (slot) + drift, regionLength);
            }
        }
    }

    /**
        Whose heads the editor draws. Every voice has its own now, and the window has one line per
        head - so the newest voice still sounding is the one shown, and a played note takes the
        line over from the drone and hands it back when it ends.

        With nothing sounding every voice is anchored, so the drone's copy reads out as Position
        itself: the line rests where the next note will start from.
    */
    int32 drawnVoice()
    {
        int32 newest = droneVoice;
        int64 newestStart = -1;

        for (int32 v = 0; v < voiceCount; ++v)
        {
            if (voiceEnvStage.at (v) != envIdle && voiceStartedAt.at (v) > newestStart)
            {
                newestStart = voiceStartedAt.at (v);
                newest = v;
            }
        }

        return newest;
    }

    //==============================================================================
    void reportState()
    {
        displayCountdown -= 1.0;

        if (displayCountdown > 0.0)
            return;

        displayCountdown = processor.frequency / float64 (displayHz);

        int32 active;

        for (int32 i = 0; i < maxGrains; ++i)
            if (grains.at (i).active)
                ++active;

        EngineState state;

        let drawn = drawnVoice();

        for (int32 h = 0; h < headCount; ++h)
            state.headPositions.at (h) = sampleFrameCount > 0
                                           ? float32 ((float64 (loopStartFrame (h))
                                                         + readHeadOffset (drawn, h))
                                                        / float64 (sampleFrameCount))
                                           : 0.0f;

        state.levelLeft = peakLeft;
        state.levelRight = peakRight;
        state.activeGrains = active;
        state.loadedFrames = sampleReady ? sampleFrameCount : 0;
        state.bufferRate = float32 (bufferRate);

        stateOut <- state;
        peakLeft = 0.0f;
        peakRight = 0.0f;
    }

    //==============================================================================
    /// About how long the output gain takes to reach a new setting.
    let gainSmoothingSeconds = 0.02;

    void main()
    {
        buildRampTable();

        /**
            Unseeded, every instance of the patch runs the same sequence - so two Cloud Chamber tracks
            would jitter their grains in lockstep and sound like one wide instrument rather than
            two. processor.id separates the instances; processor.session makes the cloud differ
            from one run to the next rather than being the same performance every time.
        */
        rng.seed (int64 (processor.session) * 8191L + int64 (processor.id));

        gainSmoothingCoefficient = float32 (1.0 / max (1.0, gainSmoothingSeconds * processor.frequency));

        /// A scale of zero would stall a phase outright, and no scheduler must be able to open
        /// onto one - so they start at the value a head with no jitter would draw.
        for (int32 i = 0; i < schedulerSlots; ++i)
            intervalScale.at (i) = 1.0;

        loop
        {
            scheduleGrains();

            float32 left, right;

            for (int32 i = 0; i < maxGrains; ++i)
            {
                if (! grains.at (i).active)
                    continue;

                let window = grainEnvelope (grains.at (i).envPhase,
                                            grains.at (i).attackFraction,
                                            grains.at (i).decayFraction);

                let voiceEnvelope = voiceEnvLevel.at (grains.at (i).voice);
                let sample = readGrain (i) * window * voiceEnvelope;

                left += sample * grains.at (i).gainLeft;
                right += sample * grains.at (i).gainRight;

                advanceGrain (i);
                grains.at (i).envPhase += grains.at (i).envDelta;

                if (grains.at (i).envPhase >= 1.0)
                    grains.at (i).active = false;
            }

            smoothedGain += (targetGain - smoothedGain) * gainSmoothingCoefficient;

            left *= smoothedGain;
            right *= smoothedGain;

            peakLeft = max (peakLeft, abs (left));
            peakRight = max (peakRight, abs (right));

            out <- float32<2> (left, right);

            advanceScan();

            if (grainEmitCountdown > 0.0)
                grainEmitCountdown -= 1.0;

            reportState();
            advance();
        }
    }
}
