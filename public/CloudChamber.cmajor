    //==============================================================================
    // Global parameters - the keyboard and the output, which belong to the instrument rather
    // than to any one head.

    input event float32 attackIn   [[ name: "Attack",    min: 0,   max: 8000, init: 20,  unit: "ms", step: 1 ]];
    input event float32 decayIn    [[ name: "Decay",     min: 0,   max: 8000, init: 400, unit: "ms", step: 1 ]];
    input event float32 sustainIn  [[ name: "Sustain",   min: 0,   max: 1,    init: 1,   step: 0.001 ]];
    input event float32 releaseIn  [[ name: "Release",   min: 0,   max: 8000, init: 600, unit: "ms", step: 1 ]];
    input event float32 keyTrackIn [[ name: "Key Track", min: 0,   max: 1,    init: 1,   step: 0.001 ]];
    input event float32 freeRunIn  [[ name: "Free Run",  min: 0,   max: 1,    init: 0,   text: "Off|On", boolean ]];
    input event float32 rootNoteIn [[ name: "Root Note", min: 0,   max: 127,  init: 60,  step: 1 ]];
    input event float32 gainIn     [[ name: "Output",    min: -60, max: 12,   init: -6,  unit: "dB", step: 0.1 ]];

    //==============================================================================
    // Sample transfer

    input event SampleInfo  sampleBeginIn;
    input event SampleChunk sampleChunkIn;
    input event int32       sampleEndIn;

    struct SampleInfo
    {
        int32 frameCount;
        float32 sampleRate;
    }

    struct SampleChunk
    {
        int32 startFrame;
        int32 frameCount;
        float32[chunkFrames] frames;
    }

    struct GrainInfo
    {
        /// Where the grain was taken from, as a fraction of the whole buffer.
        float32 position;
        float32 lengthSeconds;
        float32 level;
        float32 pan;
        /// Signed, so the editor can draw a reversed grain as running the other way.
        float32 rate;
        int32 voice;
        int32 head;
    }

    struct EngineState
    {
        /// Every head, so the editor draws all eight without having to say which is selected.
        float32[headCount] headPositions;
        /**
            Both sides rather than one number for the pair. Pan Spread scatters a cloud across the
            image and a head can be panned outright, so the two channels routinely carry different
            levels - and a single peak of the pair would report the louder side while saying
            nothing about the quieter one going missing.
        */
        float32 levelLeft;
        float32 levelRight;
        int32 activeGrains;
        /// Frames the buffer actually holds, so the editor can confirm what arrived.
        int32 loadedFrames;
        /**
            The rate those frames are held at. The editor cannot work it out on its own after its
            window has been reopened - the sample it decoded went with the old window, while the
            buffer did not - and without it a held sample reads as no sample at all.
        */
        float32 bufferRate;
    }

    //==============================================================================
    /**
        134MB of float32, which is what buying an hour costs. Anything shorter than
        maxSampleFrames / bufferRate seconds keeps its own sample rate; past that the editor
        brings the rate down until it fits, so the hour is real but it is not full bandwidth.
        Raising this raises the rate a long sample survives at - and the plugin's footprint by
        four bytes a frame.
    */
    let maxSampleFrames = 33554432;

    /// Frames per transfer event. The performer's input queue is 64KB, so a chunk has to stay
    /// well inside it or the send blocks against a queue it cannot drain fast enough.
    let chunkFrames = 2048;

    let headCount = 8;

    let midiVoiceCount = 8;
    /// The free-running voice sits past the MIDI pool so nothing can steal it for a note.
    let droneVoice = midiVoiceCount;
    let voiceCount = midiVoiceCount + 1;

    /// One scheduler per voice per head: every head throws its own grains under every note.
    let schedulerSlots = voiceCount * headCount;

    /**
        One pool for the whole engine rather than a ration each. A drone at 24Hz with two-second
        grains wants around fifty at once and a held chord wants none, so partitioning the pool
        by voice or by head would cap the cases that need the grains in order to reserve slots
        for cases that are not sounding. It is a ceiling across all heads and all voices at once,
        which is what eight dense heads under a chord will actually reach.

        Every active grain costs an interpolated read and a window lookup per sample, so
        this is the one constant here that is paid for in CPU rather than in memory. Only grains
        that are sounding cost anything - the ceiling is what the worst case is allowed to reach,
        not what is always running.
    */
    let maxGrains = 1024;

    /**
        How long a grain takes to cross its region's join, in seconds of the buffer's own rate.

        A grain that reaches the end of its region continues at the start of it, and butting the
        two together is a step in the waveform at whatever amplitude the grain's window has
        reached - which is a click, and at the head's own wrap it is a click on every grain at
        once. Cutting to silence instead is the same step with a different destination, and thins
        the cloud out as well.

        Ten milliseconds is long enough to hide the join on material that has no business looping
        and short enough not to smear a transient sitting on it. It is capped at half the region
        below, so the two ends of a short region cannot fade through each other.
    */
    let loopCrossfadeSeconds = 0.01;

    /// A raised cosine, sampled once so a grain's edges cost a lookup rather than a cosine.
    let rampTableSize = 1024;

    let displayHz = 30.0f;
    let grainEmitHz = 60.0f;

    let envIdle = 0;
    let envAttack = 1;
    let envDecay = 2;
    let envSustain = 3;
    let envRelease = 4;

    //==============================================================================
    float32[maxSampleFrames] sampleBuffer;
    int32   sampleFrameCount;
    float64 bufferRate = 48000.0;
    bool    sampleReady;

    float32[rampTableSize] rampTable;

    //==============================================================================
    struct Grain
    {
        bool active;
        /// Carried on the grain because the pool is shared: a grain outlives its voice's say in
        /// where it sits, but still has to be under that voice's amplitude envelope.
        int32 voice;
        /**
            Which head placed it, and what it was placed under. A grain follows Level, Pan, Pitch
            and Size for as long as it sounds rather than keeping whatever those knobs said at
            the moment it was spawned: a grain runs for up to ten seconds, so a knob turn would
            otherwise take ten seconds to be heard in full, and longer still before the last
            grain that predates it has gone.

            What is kept is only what those values cannot be re-derived from - the head to read
            them off, the note and velocity the grain was sounded at (its voice may have been
            taken by another note since), and the random draws. A draw is a coin already flipped:
            the parameter scales it, but turning Pitch Jitter up cannot decide a different one,
            so the draw persists while the value it is scaled by does not.
        */
        int32 head;
        int32 note;
        float32 velocity;
        float32 levelJitterDraw, panDraw, pitchJitterDraw, sizeJitterDraw;
        /**
            The cloud this grain was born into, not the one the head is describing now - see
            headDensityCompensation. It is the one thing derived from Density and Size that does
            *not* follow them: a grain already sounding is part of the old cloud's count, and
            rescaling it to the new cloud's estimate is what makes a fast pull-back peak.
        */
        float32 densityCompensation;
        /// Reverse is a probability, so which way it landed is a draw like any other.
        float64 rateSign;
        float64 readPos;
        float64 increment;
        /// The grain loops this rather than the whole buffer, so a region sounds the same
        /// wherever in the file it sits - and crossfadeFrames is how long it takes over the join.
        float64 regionStart;
        float64 regionLength;
        float64 crossfadeFrames;
        float64 envPhase;
        float64 envDelta;
        float32 gainLeft;
        float32 gainRight;
        float32 attackFraction;
        float32 decayFraction;
    }

    Grain[maxGrains] grains;

    //==============================================================================
    bool[headCount]    headEnabled;
    float32[headCount] headLevel;
    float32[headCount] headPan, headPanSpread;
    float32[headCount] headPosition, headSpray, headMotion;
    float32[headCount] headLoopStart, headLoopLength;
    float32[headCount] headSize, headSizeJitter;
    float32[headCount] headDensity, headRateJitter;
    float32[headCount] headShape, headSkew;
    float32[headCount] headPitch, headFine, headPitchJitter;
    float32[headCount] headReverse, headLevelJitter;

    /**
        Motion's accumulator, per voice per head. Position anchors it - see readHeadOffset.

        Per voice rather than per head, so a note starts its heads at Position rather than
        wherever Motion had drifted them to while nothing was sounding. Two presses of the same
        key then read the same part of the buffer, and a chord's voices drift apart from a shared
        start instead of sharing one drift.
    */
    float64[schedulerSlots] headScanFrames;

    //==============================================================================
    bool[voiceCount]    voiceActive;
    int32[voiceCount]   voiceNote;
    float32[voiceCount] voiceVelocity;
    float32[voiceCount] voiceEnvLevel;
    int32[voiceCount]   voiceEnvStage;
    /// Rising with every allocation, so the oldest voice is the one stolen.
    int64[voiceCount]   voiceStartedAt;

    int64 voiceClock;

    /**
        How far a voice's head is towards its next grain, counted 0..1 rather than in frames left.

        A countdown in frames has to be committed the moment a grain fires, from whatever Density
        was current then - so at 1Hz, turning the knob up would not be heard until the second the
        head had already promised itself had run out. A phase changes speed the instant the
        parameter does, which is what a rate control is supposed to do.
    */
    float64[schedulerSlots] spawnPhase;

    /// The jitter drawn for the interval now running. Held rather than redrawn per frame, so
    /// Rate Jitter still moves whole grains around instead of dithering the phase.
    float64[schedulerSlots] intervalScale;

    //==============================================================================
    float32 paramAttack = 20.0f, paramDecay = 400.0f, paramSustain = 1.0f, paramRelease = 600.0f;
    float32 paramKeyTrack = 1.0f;
    int32   paramRootNote = 60;
    bool    paramFreeRun;

    float32 targetGain = 0.501187f;
    float32 smoothedGain = 0.501187f;

    /// Derived from the host rate in main(), not a bare constant: a fixed per-sample coefficient
    /// smooths twice as fast at 96k as at 48k, so the same move would sound different per session.
    float32 gainSmoothingCoefficient = 0.001f;

    float64 displayCountdown, grainEmitCountdown;
    float32 peakLeft, peakRight;

    std::random::RNG rng;

    //==============================================================================
    // Per-head parameter handlers. Position re-anchors its own head's drift rather than adding
    // to it: without that, Position 0 means the loop start only until Motion has moved anything.
    //
    // The ones that refresh are the ones a sounding grain follows rather than having snapshotted
    // - see refreshHeadGains for why the work is done here and not in the render loop.

    event h1EnableIn (float32 v) { headEnabled.at (0) = v >= 0.5f; }
    event h1LevelIn (float32 v) { headLevel.at (0) = std::levels::dBtoGain (v); refreshHeadGains (0); }
    event h1PanIn (float32 v) { headPan.at (0) = v; refreshHeadGains (0); }
    event h1PanSpreadIn (float32 v) { headPanSpread.at (0) = v; refreshHeadGains (0); }
    event h1PositionIn (float32 v) { headPosition.at (0) = v; anchorHead (0); }
    event h1SprayIn (float32 v) { headSpray.at (0) = v; }
    event h1MotionIn (float32 v) { headMotion.at (0) = v; }
    event h1LoopStartIn (float32 v) { headLoopStart.at (0) = v; }
    event h1LoopLengthIn (float32 v) { headLoopLength.at (0) = v; }
    event h1SizeIn (float32 v) { headSize.at (0) = v; refreshHeadLengths (0); }
    event h1SizeJitterIn (float32 v) { headSizeJitter.at (0) = v; refreshHeadLengths (0); }
    event h1DensityIn (float32 v) { headDensity.at (0) = v; }
    event h1RateJitterIn (float32 v) { headRateJitter.at (0) = v; }
    event h1ShapeIn (float32 v) { headShape.at (0) = v; }
    event h1SkewIn (float32 v) { headSkew.at (0) = v; }
    event h1PitchIn (float32 v) { headPitch.at (0) = v; refreshHeadRates (0); }
    event h1FineIn (float32 v) { headFine.at (0) = v; refreshHeadRates (0); }
    event h1PitchJitterIn (float32 v) { headPitchJitter.at (0) = v; refreshHeadRates (0); }
    event h1ReverseIn (float32 v) { headReverse.at (0) = v; }
    event h1LevelJitterIn (float32 v) { headLevelJitter.at (0) = v; refreshHeadGains (0); }

    event h2EnableIn (float32 v) { headEnabled.at (1) = v >= 0.5f; }
    event h2LevelIn (float32 v) { headLevel.at (1) = std::levels::dBtoGain (v); refreshHeadGains (1); }
    event h2PanIn (float32 v) { headPan.at (1) = v; refreshHeadGains (1); }
    event h2PanSpreadIn (float32 v) { headPanSpread.at (1) = v; refreshHeadGains (1); }
    event h2PositionIn (float32 v) { headPosition.at (1) = v; anchorHead (1); }
    event h2SprayIn (float32 v) { headSpray.at (1) = v; }
    event h2MotionIn (float32 v) { headMotion.at (1) = v; }
    event h2LoopStartIn (float32 v) { headLoopStart.at (1) = v; }
    event h2LoopLengthIn (float32 v) { headLoopLength.at (1) = v; }
    event h2SizeIn (float32 v) { headSize.at (1) = v; refreshHeadLengths (1); }
    event h2SizeJitterIn (float32 v) { headSizeJitter.at (1) = v; refreshHeadLengths (1); }
    event h2DensityIn (float32 v) { headDensity.at (1) = v; }
    event h2RateJitterIn (float32 v) { headRateJitter.at (1) = v; }
    event h2ShapeIn (float32 v) { headShape.at (1) = v; }
    event h2SkewIn (float32 v) { headSkew.at (1) = v; }
    event h2PitchIn (float32 v) { headPitch.at (1) = v; refreshHeadRates (1); }
    event h2FineIn (float32 v) { headFine.at (1) = v; refreshHeadRates (1); }
    event h2PitchJitterIn (float32 v) { headPitchJitter.at (1) = v; refreshHeadRates (1); }
    event h2ReverseIn (float32 v) { headReverse.at (1) = v; }
    event h2LevelJitterIn (float32 v) { headLevelJitter.at (1) = v; refreshHeadGains (1); }

    event h3EnableIn (float32 v) { headEnabled.at (2) = v >= 0.5f; }
    event h3LevelIn (float32 v) { headLevel.at (2) = std::levels::dBtoGain (v); refreshHeadGains (2); }
    event h3PanIn (float32 v) { headPan.at (2) = v; refreshHeadGains (2); }
    event h3PanSpreadIn (float32 v) { headPanSpread.at (2) = v; refreshHeadGains (2); }
    event h3PositionIn (float32 v) { headPosition.at (2) = v; anchorHead (2); }
    event h3SprayIn (float32 v) { headSpray.at (2) = v; }
    event h3MotionIn (float32 v) { headMotion.at (2) = v; }
    event h3LoopStartIn (float32 v) { headLoopStart.at (2) = v; }
    event h3LoopLengthIn (float32 v) { headLoopLength.at (2) = v; }
    event h3SizeIn (float32 v) { headSize.at (2) = v; refreshHeadLengths (2); }
    event h3SizeJitterIn (float32 v) { headSizeJitter.at (2) = v; refreshHeadLengths (2); }
    event h3DensityIn (float32 v) { headDensity.at (2) = v; }
    event h3RateJitterIn (float32 v) { headRateJitter.at (2) = v; }
    event h3ShapeIn (float32 v) { headShape.at (2) = v; }
    event h3SkewIn (float32 v) { headSkew.at (2) = v; }
    event h3PitchIn (float32 v) { headPitch.at (2) = v; refreshHeadRates (2); }
    event h3FineIn (float32 v) { headFine.at (2) = v; refreshHeadRates (2); }
    event h3PitchJitterIn (float32 v) { headPitchJitter.at (2) = v; refreshHeadRates (2); }
    event h3ReverseIn (float32 v) { headReverse.at (2) = v; }
    event h3LevelJitterIn (float32 v) { headLevelJitter.at (2) = v; refreshHeadGains (2); }

    event h4EnableIn (float32 v) { headEnabled.at (3) = v >= 0.5f; }
    event h4LevelIn (float32 v) { headLevel.at (3) = std::levels::dBtoGain (v); refreshHeadGains (3); }
    event h4PanIn (float32 v) { headPan.at (3) = v; refreshHeadGains (3); }
    event h4PanSpreadIn (float32 v) { headPanSpread.at (3) = v; refreshHeadGains (3); }
    event h4PositionIn (float32 v) { headPosition.at (3) = v; anchorHead (3); }
    event h4SprayIn (float32 v) { headSpray.at (3) = v; }
    event h4MotionIn (float32 v) { headMotion.at (3) = v; }
    event h4LoopStartIn (float32 v) { headLoopStart.at (3) = v; }
    event h4LoopLengthIn (float32 v) { headLoopLength.at (3) = v; }
    event h4SizeIn (float32 v) { headSize.at (3) = v; refreshHeadLengths (3); }
    event h4SizeJitterIn (float32 v) { headSizeJitter.at (3) = v; refreshHeadLengths (3); }
    event h4DensityIn (float32 v) { headDensity.at (3) = v; }
    event h4RateJitterIn (float32 v) { headRateJitter.at (3) = v; }
    event h4ShapeIn (float32 v) { headShape.at (3) = v; }
    event h4SkewIn (float32 v) { headSkew.at (3) = v; }
    event h4PitchIn (float32 v) { headPitch.at (3) = v; refreshHeadRates (3); }
    event h4FineIn (float32 v) { headFine.at (3) = v; refreshHeadRates (3); }
    event h4PitchJitterIn (float32 v) { headPitchJitter.at (3) = v; refreshHeadRates (3); }
    event h4ReverseIn (float32 v) { headReverse.at (3) = v; }
